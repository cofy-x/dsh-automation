{
  "name": "dsh-automation",
  "description": "Durable automation Runs and Worker execution for DeepSeek Harness",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -b --force && tsdown --config-loader tsx",
    "check:source-size": "node scripts/check-source-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "prepare": "pnpm run build",
    "prepack": "pnpm run check:source-size && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./domain": {
      "types": "./lib/types/domain.d.ts",
      "default": "./lib/domain.js"
    },
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/store.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./app": {
      "types": "./lib/types/app.d.ts",
      "default": "./lib/app.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/**/*.md",
    "examples/**/*",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/dsh-automation.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-cmdline": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0",
    "commander": ">=15.0.0 <16.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-cmdline": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-sqlite": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-shell": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "24.13.3",
    "execa": "10.0.0",
    "tsdown": "0.22.14",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
